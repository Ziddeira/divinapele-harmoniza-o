# Copie para .env (ou configure no painel da hospedagem). Nunca versione o .env.
NODE_ENV=production
PORT=3000
HOST=0.0.0.0

# Domínios autorizados a enviar o formulário (separados por vírgula)
ALLOWED_ORIGINS=https://www.divinapele.com.br,https://divinapele.com.br

# Ative quando houver proxy reverso/CDN na frente (Nginx, Cloudflare, Render, Railway...)
TRUST_PROXY=1

# Número do WhatsApp (apenas dígitos, com DDI 55)
WHATSAPP_NUMBER=5548988097020

# Onde os leads são gravados (NDJSON, permissões 600)
DATA_DIR=./data

# Opcional: encaminhar leads para n8n / Make / Zapier / CRM
LEAD_WEBHOOK_URL=
LEAD_WEBHOOK_TOKEN=

# Anti-abuso
RATE_LIMIT_WINDOW_MS=600000
RATE_LIMIT_MAX=5
MIN_FILL_MS=2500
